# =============================================================================
# QA Lab – root / shared environment example
# Copy to .env and adjust. Never commit real secrets.
# =============================================================================

# --- CLI Scanner (optional overrides) ---
# Most CLI options are flags; these are for library / worker usage.
QA_LAB_USER_AGENT=QA-Lab/1.0 (+https://github.com/CoreLink-tech/qa-lab)
QA_LAB_DEFAULT_CONCURRENCY=5
QA_LAB_DEFAULT_MAX_PAGES=100
QA_LAB_DEFAULT_DEPTH=2

# --- Backend (also see qa-lab-backend/.env.example) ---
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://qa_lab:qa_lab_password@localhost:5432/qa_lab?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-at-least-32-chars

CORS_ORIGIN=http://localhost:3000

# Future: object storage for large reports
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
