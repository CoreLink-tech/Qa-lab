# =============================================================================
# QA Lab – root / shared environment example
# Copy to .env and adjust. Never commit real secrets.
# =============================================================================

# --- CLI Scanner (optional overrides) ---
QA_LAB_USER_AGENT=QA-Lab/1.0 (+https://github.com/CoreLink-tech/Qa-lab)
QA_LAB_DEFAULT_CONCURRENCY=5
QA_LAB_DEFAULT_MAX_PAGES=100
QA_LAB_DEFAULT_DEPTH=2
# Dev-only: allow private IPs in SSRF guard (ignored when NODE_ENV=production)
# QA_LAB_ALLOW_PRIVATE_NETWORK=1

# --- Backend (also see qa-lab-backend/.env.example) ---
NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://qa_lab:CHANGE_ME_DB_PASSWORD@localhost:5432/qa_lab?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# REQUIRED in any shared environment — use long random strings (≥ 32 chars)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-at-least-32-chars

CORS_ORIGIN=http://localhost:3001

# Email: log (default) or smtp
EMAIL_MODE=log
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Worker
# RUN_MODE=all
# SCAN_TIMEOUT_MS=600000
# SCAN_ISOLATION=child

# Future object storage for large reports
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
