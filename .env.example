# =============================================================================
# QA Lab – root / shared environment example
# Copy: cp .env.example .env
# Never commit real secrets.
# =============================================================================

# --- CLI Scanner ---
QA_LAB_USER_AGENT=QA-Lab/1.0 (+https://github.com/CoreLink-tech/Qa-lab)
QA_LAB_DEFAULT_CONCURRENCY=5
QA_LAB_DEFAULT_MAX_PAGES=100
QA_LAB_DEFAULT_DEPTH=2
# Dev-only private network allow (ignored when NODE_ENV=production)
# QA_LAB_ALLOW_PRIVATE_NETWORK=1

# --- Backend (see also qa-lab-backend/.env.example) ---
NODE_ENV=development
PORT=3000
RUN_MODE=all

DATABASE_URL=postgresql://qa_lab:CHANGE_ME_DB_PASSWORD@localhost:5432/qa_lab?schema=public
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# REQUIRED (≥ 32 characters each)
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-at-least-32-chars
API_KEY_PEPPER=

CORS_ORIGIN=http://localhost:3001
APP_PUBLIC_URL=http://localhost:3001
TRUST_PROXY=false
COOKIE_SECURE=false

# Email: log (default) or smtp
EMAIL_MODE=log
EMAIL_FROM=QA Lab <noreply@example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# Scanner / worker
QA_LAB_SCANNER_ROOT=
SCAN_TIMEOUT_MS=600000
SCAN_HARD_MAX_PAGES=200
SCAN_ISOLATION=
SCAN_STUCK_MS=1200000
ORG_SCAN_CONCURRENCY=2
WORKER_CONCURRENCY=1
REPORT_JSON_MAX_BYTES=2000000
RETENTION_REPORT_DAYS=90
RETENTION_AUDIT_DAYS=180

# Optional error tracking (install @sentry/node in backend when set)
SENTRY_DSN=
