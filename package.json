{
  "name": "qa-lab",
  "version": "1.0.0",
  "description": "QA-Lab is a website quality assurance scanner that analyzes performance, SEO, accessibility, security, forms, links, and generates HTML and JSON reports.",
  "main": "src/index.js",
  "bin": {
    "qalab": "./src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "QA_LAB_ALLOW_PRIVATE_NETWORK=1 node --test \"test/**/*.test.js\"",
    "test:scanner": "QA_LAB_ALLOW_PRIVATE_NETWORK=1 node --test \"test/**/*.test.js\"",
    "lint": "echo \"No root linter configured yet \u2013 scanner is CommonJS; backend has its own eslint\"",
    "build": "echo \"Scanner is pure JS \u2013 no build step required\"",
    "dev": "node src/index.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "backend:install": "npm ci --prefix qa-lab-backend",
    "backend:dev": "npm run start:dev --prefix qa-lab-backend",
    "backend:test": "npm test --prefix qa-lab-backend",
    "backend:build": "npm run build --prefix qa-lab-backend",
    "web:install": "npm install --prefix apps/web",
    "web:dev": "npm run dev --prefix apps/web",
    "web:build": "npm run build --prefix apps/web",
    "backend:migrate": "npm exec --prefix qa-lab-backend -- prisma migrate deploy",
    "setup": "npm run docker:up && npm run backend:install && npm run backend:migrate && npm run web:install"
  },
  "keywords": [
    "qa",
    "quality-assurance",
    "website",
    "scanner",
    "seo",
    "accessibility",
    "security",
    "performance",
    "cli",
    "audit"
  ],
  "author": "CoreLink-tech",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.19.0",
    "cheerio": "^1.2.0",
    "playwright": "^1.62.1",
    "ipaddr.js": "^2.2.0"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/CoreLink-tech/qa-lab.git"
  }
}
