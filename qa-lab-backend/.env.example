NODE_ENV=development
PORT=3000

DATABASE_URL=postgresql://qa_lab:qa_lab_password@localhost:5432/qa_lab?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Must be at least 32 characters each
JWT_ACCESS_SECRET=replace-with-a-secure-random-string-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-another-secure-random-string-32-chars+

CORS_ORIGIN=http://localhost:3001

# Path to root scanner library (src/lib). Defaults to ../src/lib from cwd.
# QA_LAB_SCANNER_ROOT=


TRUST_PROXY=false
COOKIE_SECURE=false
APP_PUBLIC_URL=http://localhost:3001
EMAIL_MODE=log

RUN_MODE=all
SCAN_TIMEOUT_MS=600000
ORG_SCAN_CONCURRENCY=2
WORKER_CONCURRENCY=1
SCAN_STUCK_MS=1200000
SCAN_HARD_MAX_PAGES=200
