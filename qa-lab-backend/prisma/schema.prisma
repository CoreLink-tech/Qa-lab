generator client {
  // "prisma-client-js" (not the newer "prisma-client" generator) because it
  // emits CommonJS output. The rest of this project -- tsconfig, eslint
  // (sourceType: commonjs), no "type": "module" in package.json -- is CJS,
  // and ts-jest's test transform can't handle the newer generator's
  // ESM-only output (import.meta.url, .js-suffixed imports on .ts files).
  // nest build tolerates it via a TS compiler transform; ts-jest does not,
  // so no test touching the database layer could run under that generator.
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum ScanStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ScanTrigger {
  MANUAL
  SCHEDULED
  API
  CI_CD
}

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  firstName       String?
  lastName        String?
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?

  /// Failed password attempts since last successful login
  failedLoginCount Int      @default(0)
  lockedUntil      DateTime?

  emailVerifyTokenHash String?
  emailVerifyExpiresAt DateTime?

  memberships     OrganizationMember[]
  refreshTokens   RefreshToken[]
  passwordResets  PasswordResetToken[]
  apiKeys         ApiKey[]
  auditLogs       AuditLog[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
  @@index([lockedUntil])
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique

  members     OrganizationMember[]
  projects    Project[]
  apiKeys     ApiKey[]
  auditLogs   AuditLog[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdAt])
}

model OrganizationMember {
  id             String           @id @default(uuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId, role])
}

model Project {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  slug           String
  description    String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  websites       Website[]
  scans          Scan[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Website {
  id          String   @id @default(uuid())
  projectId   String
  name        String
  url         String
  isActive    Boolean  @default(true)

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  scans       Scan[]
  schedules   ScanSchedule[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, url])
  @@index([projectId])
  @@index([isActive])
}

model Scan {
  id          String      @id @default(uuid())
  projectId   String
  websiteId   String

  status      ScanStatus  @default(QUEUED)
  trigger     ScanTrigger @default(MANUAL)

  // Snapshot of the scan settings used for this run (maxPages, depth, etc.)
  options     Json?

  queuedAt    DateTime    @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  pagesScanned Int?
  error       String?

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  website     Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  report      Report?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId, createdAt])
  @@index([websiteId, createdAt])
  @@index([status])
  @@index([status, createdAt])
}

model Report {
  id          String   @id @default(uuid())
  scanId      String   @unique

  score       Int?
  grade       String?
  issueCount  Int      @default(0)

  reportJson  Json
  reportHtml  String?

  scan        Scan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RefreshToken {
  id          String   @id @default(uuid())
  userId      String

  tokenHash   String   @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  userAgent   String?
  ipAddress   String?

  /// Rotation family id — reuse of a revoked token revokes the whole family
  familyId    String
  /// True after this token was rotated to a successor
  replacedAt  DateTime?

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([userId, revokedAt])
  @@index([familyId])
}

model ApiKey {
  id             String    @id @default(uuid())
  organizationId String
  createdById    String?

  name           String    // human-readable label, e.g. "CI pipeline"

  // The raw key is shown to the user exactly once at creation and never
  // stored or displayed again. `prefix` (a short, non-secret slice of
  // the raw key, e.g. its first 8-12 characters) is stored in plaintext
  // so the UI can show "Key starting with qalab_live_AbCd..." without
  // ever needing the full value again. `keyHash` is a hash of the FULL
  // raw key, checked against on every authenticated request -- same
  // "never store the raw secret" pattern as RefreshToken.tokenHash.
  prefix         String
  keyHash        String    @unique

  scopes         String[]  @default([])

  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Nullable + SetNull (not Cascade) on purpose: an API key belongs to
  // the organization, not to the user who happened to create it. The
  // key should keep working after that user is deleted, same reasoning
  // as AuditLog.userId below.
  createdBy      User? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, revokedAt])
  @@index([createdById])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?

  action         String
  resource       String
  resourceId     String?
  metadata       Json?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  user           User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([resource, resourceId])
}


model ScanSchedule {
  id          String   @id @default(uuid())
  websiteId   String

  /// Interval in hours between runs (1–168)
  intervalHours Int     @default(24)
  enabled     Boolean  @default(true)

  options     Json?

  lastRunAt   DateTime?
  nextRunAt   DateTime?

  website     Website  @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([websiteId])
  @@index([enabled, nextRunAt])
}


model PasswordResetToken {
  id          String   @id @default(uuid())
  userId      String
  tokenHash   String   @unique
  expiresAt   DateTime
  usedAt      DateTime?

  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}
